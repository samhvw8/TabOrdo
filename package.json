    "svelte": "^5.55.8",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "tiny-pinyin": "^1.3.2",
