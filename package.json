{
  "name": "tab-ordo",
  "version": "0.1.0",
  "description": "Tab management Chrome extension with command palette and dashboard",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@webext-core/fake-browser": "^1.3.4",
    "@wxt-dev/module-svelte": "^2.0.5",
    "svelte": "^5.55.8",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "wxt": "^0.20.26"
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "^1.0.19",
    "tldts": "^7.0.30"
  },
  "overrides": {
    "@webext-core/fake-browser": "1.3.4"
  }
}
